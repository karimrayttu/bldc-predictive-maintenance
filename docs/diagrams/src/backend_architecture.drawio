<mxfile host="app.diagrams.net" type="device">
  <diagram name="Backend architecture" id="backend-architecture">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="0"
                  pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="One firmware, three front ends, one shared contract" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#1B2A34;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="760" height="28" as="geometry"/></mxCell>
        <mxCell id="n" value="Each front end opens its own port. What they share is the column set and the sensor equations, so those cannot drift apart." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#4A5761;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="820" height="34" as="geometry"/></mxCell>
        <mxCell id="fw" value="NUCLEO-F401RE firmware&lt;br&gt;44 CSV columns at 10 Hz, 115200 baud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF1F3;strokeColor=#6B7A85;strokeWidth=1.6;fontColor=#2C3940;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="vcp" value="ST-LINK virtual COM port&lt;br&gt;Windows bench" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FB;strokeColor=#2E5E8E;strokeWidth=1.6;fontColor=#0F3050;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="150" y="216" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="uart" value="UART on the 40-pin header&lt;br&gt;Raspberry Pi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FB;strokeColor=#2E5E8E;strokeWidth=1.6;fontColor=#0F3050;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="730" y="216" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="bench" value="apps/bench&lt;br&gt;PyQt campaign app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FB;strokeColor=#2E5E8E;strokeWidth=1.6;fontColor=#0F3050;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="260" height="62" as="geometry"/></mxCell>
        <mxCell id="demo" value="apps/demo&lt;br&gt;Pi touchscreen" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FB;strokeColor=#2E5E8E;strokeWidth=1.6;fontColor=#0F3050;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="240" height="62" as="geometry"/></mxCell>
        <mxCell id="web" value="apps/web&lt;br&gt;headless HTTP view" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FB;strokeColor=#2E5E8E;strokeWidth=1.6;fontColor=#0F3050;fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="240" height="62" as="geometry"/></mxCell>
        <mxCell id="chain" value="bench only&lt;br&gt;sources.py, validator.py, session.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF1E3;strokeColor=#B8763A;strokeWidth=1.6;fontColor=#5A3212;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="250" y="434" width="300" height="62" as="geometry"/></mxCell>
