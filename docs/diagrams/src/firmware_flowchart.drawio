<mxfile host="app.diagrams.net"><diagram name="Firmware flowchart"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;RESET&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;power-on or NRST&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="300" height="64" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;1.&amp;#160; Initialize and self-test&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;RCC to 16 MHz HSI &amp;#183; ADC1 CH0/CH1 &amp;#183; EXTI on the three Hall pins&lt;br&gt;bit-banged I&amp;#178;C &amp;#183; USART2 at 115200 8N1&lt;br&gt;KX134 answers WHO_AM_I = 0x46 at address 0x1F&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="124" width="300" height="124" as="geometry"/></mxCell><mxCell id="cA" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="197" y="278" width="46" height="46" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;2.&amp;#160; Sample the sensors&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;oversample A0 and A1, read KX134 X/Y/Z,&lt;br&gt;latch the Hall edge timestamps&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#EEF3F9;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="354" width="300" height="96" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;3.&amp;#160; Convert to engineering units&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;I&lt;sub&gt;bus&lt;/sub&gt; = &amp;#916;V(A0) &amp;#247; 263.5 mV/A &amp;#183; n = 60 &amp;#183; f&lt;sub&gt;Hall&lt;/sub&gt; &amp;#247; 4&lt;br&gt;T from the NTC curve &amp;#183; a&lt;sub&gt;rms&lt;/sub&gt; and a&lt;sub&gt;pk&lt;/sub&gt; from the KX134&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="300" height="116" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;4.&amp;#160; Transmit the frame&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;44 CSV fields every 100 ms, 10 Hz,&lt;br&gt;sent whether or not a verdict is due&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#EEF3F9;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="626" width="300" height="96" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;5.&amp;#160; Append to the 1 s window&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ring of the last 10 frames&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="752" width="300" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;6.&amp;#160; 5th frame since&lt;br&gt;the last check?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;classify twice a second&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFF7E6;strokeColor=#B8860B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="862" width="300" height="120" as="geometry"/></mxCell><mxCell id="cB1" value="B" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="197" y="1012" width="46" height="46" as="geometry"/></mxCell><mxCell id="cB2" value="B" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="577" y="30" width="46" height="46" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;7.&amp;#160; n &amp;#8805; 150 RPM and&lt;br&gt;t&lt;sub&gt;run&lt;/sub&gt; &amp;#8805; 10 s?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;is the motor really turning?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFF7E6;strokeColor=#B8860B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="106" width="300" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;8.&amp;#160; compute_features()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;16 statistics: means, spreads, extrema,&lt;br&gt;temperature slope, gravity deviation&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;size=0.06;" vertex="1" parent="1"><mxGeometry x="450" y="256" width="300" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;9.&amp;#160; any measured&lt;br&gt;limit crossed?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;fixed thresholds, first match wins&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFF7E6;strokeColor=#B8860B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="386" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;10.&amp;#160; classify_tree()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;33 nodes, depth 7, evaluated on&lt;br&gt;those same 16 features&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;size=0.06;" vertex="1" parent="1"><mxGeometry x="450" y="536" width="300" height="100" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;11.&amp;#160; does the matching&lt;br&gt;channel agree?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;the class must be backed by its own sensor&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFF7E6;strokeColor=#B8860B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="666" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;12.&amp;#160; Persistence filter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;the answer must repeat before it is shown:&lt;br&gt;healthy &amp;#215;2, loose mount &amp;#215;6, other faults &amp;#215;4&lt;br&gt;(&amp;#215;12 if a drag report came within 60 s)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="816" width="300" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;13.&amp;#160; Publish the verdict&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;fault code into column 44 of the frame;&lt;br&gt;the dashboard banner follows&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#EEF3F9;strokeColor=#1F3864;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="956" width="300" height="96" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;FAULT_IDLE_NA = 15&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;nothing to judge while&lt;br&gt;the motor is stopped&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#F4F5F7;strokeColor=#8A9099;strokeWidth=1.5;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;RULE VERDICT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;2 rotor drag &amp;#183; 3 overheat&lt;br&gt;4 motor position &amp;#183; 1 loose mount&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FDF0EF;strokeColor=#B3382C;strokeWidth=2;fontColor=#8C2A20;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="220" height="100" as="geometry"/></mxCell><mxCell id="leg" value="Symbols: stadium = start &amp;#183; rectangle = process &amp;#183; parallelogram = input / output &amp;#183; double-barred rectangle = subroutine &amp;#183; diamond = decision &amp;#183; circle = on-page connector." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#495057;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="1110" width="980" height="40" as="geometry"/></mxCell><mxCell id="e_n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="cA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cA" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="922"/><mxPoint x="405" y="402"/></Array></mxGeometry></mxCell><mxCell id="e7y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="cB1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cB2" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12y" value="yes, keep the class" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12n" value="no, demote to healthy (0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.36;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="726"/><mxPoint x="790" y="856"/></Array></mxGeometry></mxCell><mxCell id="e_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.73;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="450"/><mxPoint x="1085" y="896"/></Array></mxGeometry></mxCell><mxCell id="e_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="166"/><mxPoint x="1120" y="1004"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="next frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#495057;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="cA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="1080"/><mxPoint x="25" y="1080"/><mxPoint x="25" y="301"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>